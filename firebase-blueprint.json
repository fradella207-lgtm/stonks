{
  "entities": {
    "Transaction": {
      "title": "Transaction",
      "description": "A financial income or expense entry in stonks",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "type": { "type": "string", "enum": ["income", "expense"] },
        "description": { "type": "string", "maxLength": 300 },
        "amount": { "type": "number" },
        "month": { "type": "string" },
        "category": { "type": "string", "maxLength": 100 },
        "location": { "type": "string", "maxLength": 200 },
        "receiptImage": { "type": "string" },
        "updatedAt": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["date", "type", "description", "amount", "month"]
    }
  },
  "firestore": {
    "/users/{userId}/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "User's personal finance transactions collection"
    }
  }
}
